<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kick Analyzer — Pyodide</title>
<script src="https://cdn.jsdelivr.net/pyodide/v0.28.0/full/pyodide.js"></script>
<style>
  :root{--bg:#0f1216;--panel:#161a20;--line:#232a33;--text:#ccd;--dim:#889;
        --wave:#4fd6e0;--env:#ffb347}
  *{box-sizing:border-box}
  body{margin:0;padding:16px;background:var(--bg);color:var(--text);
       font:13px/1.5 ui-monospace,Menlo,Consolas,monospace}
  h1{font-size:14px;margin:0 0 12px 0}
  #status{padding:6px 10px;background:var(--panel);border-left:3px solid var(--wave);
          color:var(--dim);font-size:12px;border-radius:3px;margin-bottom:12px}
  #status.err{border-left-color:#ff5f6d;color:#ff5f6d}
  #status.ok{border-left-color:#5ee08a;color:#5ee08a}
  input[type=file]{display:block;margin-bottom:12px;color:var(--dim);
                   font-size:12px;width:100%}
  canvas{display:block;width:100%;height:220px;background:#0b0e12;
         border-radius:4px;margin-top:10px}
  #output{white-space:pre-wrap;background:var(--panel);border:1px solid var(--line);
          border-radius:4px;padding:10px;font-size:11px;color:var(--dim);
          margin-top:10px;max-height:260px;overflow:auto}
  button{font:inherit;font-size:12px;background:#1d242c;color:var(--text);
         border:1px solid var(--line);border-radius:4px;padding:6px 14px;
         cursor:pointer;margin-top:8px}
  button:disabled{opacity:.4;cursor:default}
</style>
</head>
<body>
<h1>Kick Analyzer — Pyodide / WASM</h1>
<div id="status">Loading Pyodide (~10 MB, cached after first visit)…</div>

<input type="file" id="wavInput" accept=".wav" disabled>
<canvas id="scope" width="1000" height="220"></canvas>
<div id="output">ready.</div>
<button id="playBtn" disabled>▶ play</button>

<script>
"use strict";
const statusEl = document.getElementById("status");
const outEl    = document.getElementById("output");
const fileEl   = document.getElementById("wavInput");
const playBtn  = document.getElementById("playBtn");
const canvas   = document.getElementById("scope");

let pyodide = null;
let lastBuffer = null;   // AudioBuffer for playback
let lastSamples = null;  // Float32Array mono for the scope

function setStatus(msg, cls){
  statusEl.textContent = msg;
  statusEl.className = cls || "";
}
function log(msg){ outEl.textContent += "\n" + msg; outEl.scrollTop = outEl.scrollHeight; }

/* ---------- draw scope (same renderer as the kick demo) ---------- */
function drawScope(samples, landmarks){
  const dpr = window.devicePixelRatio || 1;
  const W = canvas.clientWidth || 1000, H = canvas.clientHeight || 220;
  canvas.width  = Math.round(W*dpr);
  canvas.height = Math.round(H*dpr);
  const ctx = canvas.getContext("2d");
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,W,H);

  const padL=44, padR=12, padT=16, padB=26;
  const plotW = W-padL-padR, plotH = H-padT-padB;
  const yMid  = padT + plotH/2, yScl = (plotH/2)/1.15;

  const dur_ms = samples.length/44100*1000;
  const step = dur_ms <= 120 ? 20 : dur_ms <= 260 ? 25 : 50;
  ctx.strokeStyle="#1a2129"; ctx.fillStyle="#5c6672";
  ctx.font="10px ui-monospace,monospace"; ctx.textAlign="center";
  for (let m=0; m<=dur_ms; m+=step){
    const X = padL + (m/dur_ms)*plotW;
    ctx.beginPath(); ctx.moveTo(X,padT); ctx.lineTo(X,padT+plotH); ctx.stroke();
    ctx.fillText(m+" ms", X, H-8);
  }
  ctx.strokeStyle="#2a333d";
  ctx.beginPath(); ctx.moveTo(padL,yMid); ctx.lineTo(padL+plotW,yMid); ctx.stroke();

  const n=samples.length, pxPerCol=n/plotW;
  ctx.strokeStyle="#4fd6e0"; ctx.lineWidth=1; ctx.beginPath();
  for (let p=0; p<plotW; p++){
    const i0=Math.floor(p*pxPerCol), i1=Math.min(n,Math.floor((p+1)*pxPerCol));
    if (i1<=i0) continue;
    let mn=1,mx=-1;
    for (let i=i0;i<i1;i++){const v=samples[i]; if(v<mn)mn=v; if(v>mx)mx=v;}
    const X=padL+p+0.5;
    ctx.moveTo(X,yMid-mx*yScl); ctx.lineTo(X,yMid-mn*yScl);
  }
  ctx.stroke();

  if (landmarks){
    const marks=[["attack",landmarks.attack,"#ff5f6d"],
                 ["valley",landmarks.valley,"#ffd166"],
                 ["reswell",landmarks.reswell,"#5ee08a"],
                 ["fall",landmarks.fall,"#a78bfa"]];
    ctx.font="10px ui-monospace,monospace"; ctx.textAlign="center";
    for (const [label,t,color] of marks){
      if (t==null) continue;
      const X = padL + (t/dur_ms)*plotW;
      ctx.strokeStyle=color; ctx.globalAlpha=.85;
      ctx.beginPath(); ctx.moveTo(X,padT); ctx.lineTo(X,padT+plotH); ctx.stroke();
      ctx.globalAlpha=1; ctx.fillStyle=color; ctx.fillText(label,X,padT-4);
    }
  }
}

/* ---------- AudioContext pinned to 44.1 kHz (gotcha #1) ---------- */
const AC = new (window.AudioContext || window.webkitAudioContext)({sampleRate:44100});

/* ---------- load a WAV into both AudioBuffer (playback) and Float32Array (scope) ---------- */
async function loadWav(file){
  const ab = await file.arrayBuffer();
  const buf = await AC.decodeAudioData(ab.slice(0));
  lastBuffer = buf;
  const ch = buf.getChannelData(0);
  lastSamples = new Float32Array(ch);  // copy — channel data is live
  return lastSamples;
}

/* ---------- boot Pyodide ---------- */
async function boot(){
  try {
    pyodide = await loadPyodide();
    setStatus("Loading numpy + scipy…");
    await pyodide.loadPackage(["numpy","scipy"]);
    setStatus("Ready. Choose a WAV.");
    fileEl.disabled = false;
    playBtn.disabled = false;
    log("Pyodide ready. numpy + scipy loaded.");
  } catch(e){
    setStatus("Pyodide failed: " + e.message, "err");
    console.error(e);
  }
}
boot();

/* ---------- file → JS array → Python analysis ---------- */
fileEl.addEventListener("change", async (ev) => {
  const file = ev.target.files[0];
  if (!file) return;
  outEl.textContent = "";
  setStatus("Decoding " + file.name + "…");
  const samples = await loadWav(file);
  setStatus("Analyzing in Python…");

  // Pass samples to Python as a typed array — no JSON, no stringify
  pyodide.globals.set("_samples", samples);
  pyodide.runPython(`
    import numpy as np
    _x = np.asarray(_samples, dtype=np.float32)
    _sr = 44100
    print(f"loaded {len(_x)} samples ({len(_x)/_sr*1000:.1f} ms)")
  `);

  // --- Your analyzer functions go here, unchanged ---
  // For now, run a minimal envelope + landmark pass as proof of bridge.
  const result = pyodide.runPython(`
    import numpy as np
    from scipy.signal import find_peaks

    x = _x / (np.abs(_x).max() + 1e-12)

    # cycle-peak envelope (Cell 4, v2)
    s = np.sign(x); s[s==0]=1
    zc = np.where(np.diff(s)!=0)[0] + 1
    t_env, v_env = [], []
    for k in range(len(zc)-1):
        a,b = zc[k], zc[k+1]
        if b-a < 2: continue
        sub = x[a:b]
        idx = int(np.argmax(np.abs(sub)))
        t_env.append((a+idx)/_sr*1000)
        v_env.append(abs(float(sub[idx])))
    t_env = np.array(t_env); v_env = np.array(v_env)

    peak = float(v_env.max())
    i5 = np.where(t_env <= 5.0)[0]
    i_atk = int(i5[np.argmax(v_env[i5])]) if len(i5) else int(np.argmax(v_env))
    atk_t = float(t_env[i_atk]); atk_l = float(v_env[i_atk])

    after = t_env > atk_t + 1.0
    ta, va = t_env[after], v_env[after]
    prom = 0.05*atk_l
    valleys,_ = find_peaks(-va, prominence=prom)
    peaks,_   = find_peaks( va, prominence=prom)

    valley_t = float(ta[valleys[0]]) if len(valleys) else None
    reswell_t = None
    if len(valleys):
        rp = peaks[peaks > valleys[0]]
        if len(rp): reswell_t = float(ta[rp[0]])
    above = np.where(v_env > 0.01*atk_l)[0]
    fall_t = float(t_env[above[-1]]) if len(above) else float(t_env[-1])

    {
      'attack': atk_t, 'valley': valley_t,
      'reswell': reswell_t, 'fall': fall_t,
      'peak_t': float(t_env[int(np.argmax(v_env))]),
      'dur_ms': float(t_env[-1]),
    }
  `);
  const lm = result.toJs({dict_converter: Object.fromEntries});
  result.destroy();

  drawScope(samples, lm);
  log(`dur ${lm.dur_ms.toFixed(1)} ms · attack ${lm.attack.toFixed(2)} ms` +
      ` · valley ${lm.valley!=null?lm.valley.toFixed(2):"—"} ms` +
      ` · reswell ${lm.reswell!=null?lm.reswell.toFixed(2):"—"} ms`);
  setStatus("Done.", "ok");
});

playBtn.addEventListener("click", () => {
  if (!lastBuffer) return;
  if (AC.state === "suspended") AC.resume();
  const src = AC.createBufferSource();
  src.buffer = lastBuffer;
  src.connect(AC.destination);
  src.start();
});
</script>
</body>
</html>
